<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara_robot">

    <!-- ================= PROPIEDADES ================= -->
    <xacro:property name="link_radius" value="0.05"/>
    <xacro:property name="base_height" value="0.25"/>
    <xacro:property name="arm1_length" value="0.4"/>
    <xacro:property name="arm2_length" value="0.3"/>
    <xacro:property name="base_weight" value="6.0"/>
    <xacro:property name="arm1_weight" value="2.7"/>
    <xacro:property name="arm2_weight" value="1.7"/>
    <xacro:property name="prismatic_weight" value="1.2"/>
    <xacro:property name="gripper_base_weight" value="0.2"/>
    <xacro:property name="finger_weight" value="0.05"/>

    <!-- ================= MATERIALES ================= -->
    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.4 0.0 1.0"/>
    </material>
    <material name="blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
    </material>

    <!-- ================= BASE ================= -->
    <!-- Proyección en el suelo (z = 0) -->
    <link name="base_footprint" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Cilindro principal de la base -->
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="${link_radius}" length="${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
            <material name="dark_grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${link_radius}" length="${base_height}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="${base_weight}"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
        </inertial>

    </link>

    <!-- ================= MACRO PARA BRAZOS ================= -->
    <xacro:macro name="scara_arm" params="prefix parent length weight color_name *origin">
        
        <!-- Articulación de rotación (Eje Z) -->
        <joint name="${prefix}_joint" type="revolute">
            <parent link="${parent}" />
            <child link="${prefix}_link" />
            <xacro:insert_block name="origin" />
            <axis xyz="0 0 1" />
            <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0" />
        </joint>

        <!-- Eslabón rectangular -->
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="${length} 0.08 0.08" />
                </geometry>
                <!-- Desplazamos la geometría la mitad en X para que gire desde el extremo -->
                <origin xyz="${length/2} 0 0" rpy="0 0 0" />
                <material name="${color_name}" />
            </visual>
            <collision>
                <geometry>
                    <box size="${length} 0.08 0.08" />
                </geometry>
            </collision>
            <inertial>
                <mass value="${weight}"/>
                <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
            </inertial>
        </link>

    </xacro:macro>

    <!-- ================= INSTANCIAS DE LOS BRAZOS ================= -->
    <!-- Primer Brazo (Naranja) -->
    <xacro:scara_arm prefix="arm1" parent="base_link" length="${arm1_length}" weight="${arm1_weight}" color_name="orange">
        <origin xyz="0 0 ${base_height - 0.04}" rpy="0 0 0" />
    </xacro:scara_arm>

    <!-- Segundo Brazo (Azul, conectado al final del primero) -->
    <xacro:scara_arm prefix="arm2" parent="arm1_link" length="${arm2_length}" weight="${arm2_weight}" color_name="blue">
        <origin xyz="${arm1_length} 0 0.08" rpy="0 0 0" />
    </xacro:scara_arm>

    <!-- ================= EJE VERTICAL (PRISMÁTICO) ================= -->
    <joint name="z_joint" type="prismatic">
        <parent link="arm2_link" />
        <child link="z_link" />
        <!-- Colocado al final del segundo brazo -->
        <origin xyz="${arm2_length} 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <!-- Movimiento vertical entre -0.15 m y 0.0 m -->
        <limit lower="-0.15" upper="0.0" effort="20.0" velocity="0.2" />
    </joint>

    <link name="z_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.3" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="dark_grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.3" />
            </geometry>
        </collision>
        <inertial>
            <mass value="${prismatic_weight}"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
        </inertial>
    </link>

    <!-- ================= BASE DEL GRIPPER ================= -->
    <joint name="gripper_base_joint" type="fixed">
        <parent link="z_link" />
        <child link="gripper_base" />
        <origin xyz="0 0 -0.15" rpy="0 0 0" />
    </joint>

    <link name="gripper_base">
        <visual>
            <geometry>
                <box size="0.04 0.12 0.02" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="dark_grey" />
        </visual>
        <collision>
            <geometry>
                <box size="0.04 0.12 0.02" />
            </geometry>
        </collision>
        <inertial>
            <mass value="${gripper_base_weight}"/>
            <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
        </inertial>
    </link>

    <!-- ================= MACRO Y DEDOS DEL GRIPPER ================= -->
    <xacro:macro name="gripper_finger" params="prefix Y_offset">
        <joint name="${prefix}_finger_joint" type="prismatic">
            <parent link="gripper_base" />
            <child link="${prefix}_finger_link" />
            <origin xyz="0 ${Y_offset} -0.03" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <limit lower="-0.02" upper="0.02" effort="5.0" velocity="0.1" />
        </joint>

        <link name="${prefix}_finger_link">
            <visual>
                <geometry>
                    <box size="0.02 0.01 0.04" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="orange" />
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.01 0.04" />
                </geometry>
            </collision>
            <inertial>
                <mass value="${finger_weight}"/>
                <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
            </inertial>
        </link>
    </xacro:macro>

    <!-- Instancias de los dos dedos -->
    <xacro:gripper_finger prefix="left" Y_offset="0.04" />
    <xacro:gripper_finger prefix="right" Y_offset="-0.04" />

</robot>